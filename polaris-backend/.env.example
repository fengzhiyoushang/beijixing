# ═══════════ 应用 ═══════════
APP_NAME=Polaris Terminal API
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1

# ═══════════ 数据库 ═══════════
# mysql | sqlite —— mysql 不可用时自动回退 sqlite，保证开箱即跑
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=polaris_terminal
MYSQL_CHARSET=utf8mb4
SQLITE_PATH=data/polaris.db
DB_ECHO=false

# ═══════════ Redis ═══════════
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true
CACHE_TTL=300

# ═══════════ JWT ═══════════
JWT_SECRET=change-me-in-production-polaris-terminal-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ═══════════ DeepSeek ═══════════
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VL_MODEL=deepseek-vl
DEEPSEEK_TIMEOUT=60
MAX_TOOL_ROUNDS=4

# ═══════════ 向量 / RAG ═══════════
# local（零依赖哈希向量） | deepseek（调用远端 embedding 接口）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=deepseek-embedding
EMBEDDING_DIM=512
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5

# ═══════════ 微信小程序（订阅消息推送）═══════════
# 小程序 AppID（已填：北极星个人战略终端）
WX_APPID=wx2e2a95bab9e1cc88
# AppSecret：公众平台 → 开发管理 → 开发设置 → 小程序密钥（复制后填入，用于换取 access_token）
WX_APP_SECRET=
# 公众平台 → 订阅消息 → 我的模板，申请后把模板 ID 填这里
WX_TEMPLATE_DDL=
WX_TEMPLATE_CLASS=
WX_MP_STATE=formal
WX_PUSH_ENABLED=true
WX_DDL_AHEAD_MINUTES=180
WX_CLASS_AHEAD_MINUTES=30
# 进程内定时扫描（生产建议关闭，改用 cron 调 scripts/push_reminders.py）
WX_SCHEDULER_ENABLED=false
WX_PUSH_INTERVAL_MIN=10

# ═══════════ 其它 ═══════════
CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200,http://localhost:5173
UPLOAD_DIR=uploads
BACKUP_DIR=backups
MAX_UPLOAD_MB=20

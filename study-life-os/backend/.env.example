# ───── StudyLifeOS backend 环境变量模板 ─────
# 复制为 .env 后按需修改。全部留空时：SQLite + 内存缓存 + AI 降级，开箱可运行。

APP_NAME=StudyLifeOS API
DEBUG=true
SECRET_KEY=dev-se…tion

# 数据库：sqlite（默认，零依赖）| mysql
DB_BACKEND=sqlite
# 直接指定完整连接串可覆盖上面的拼装逻辑：
# DATABASE_URL=mysql+pymysql://root:pass@127.0.0.1:3306/study_life_os?charset=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_…e_os

# Redis（连不上自动回退进程内缓存）
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# DeepSeek 开放 API
DEEPSEEK_API_KEY=
DEEPSEEK…m/v1
DEEPSEEK_MODEL=deepseek-chat

# 微信小程序（留空则 wx-login 走开发模式固定 openid）
WX_APPID=
WX_SECRET=
WX_SUBSC…TE_ID=

# 其他
UPLOAD_DIR=uploads
SEED_DEMO=true
